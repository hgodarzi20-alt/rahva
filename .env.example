# PostgreSQL — پس از نصب Postgres.app یک دیتابیس به نام rahva بسازید
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rahva?schema=public"

# کلید امضای کوکی نشست — در محیط واقعی حتما عوض شود
SESSION_SECRET="dev-only-secret-change-me-please-32chars"

# کلیدهای رمزنگاری کد ملی و شماره گواهینامه — هر دو باید ۳۲ بایت و base64 باشند.
# برای ساختن هرکدام این دستور را اجرا کنید و خروجی را جایگزین کنید:
#   openssl rand -base64 32
# هشدار: پس از ثبت داده، تغییر این کلیدها داده‌های رمزنگاری‌شده قبلی را غیرقابل خواندن می‌کند.
RAHVA_HMAC_KEY="CHANGE_ME_base64_32_bytes"
RAHVA_ENC_KEY="CHANGE_ME_base64_32_bytes"
